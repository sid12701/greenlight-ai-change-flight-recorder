# Copy to .env.demo. The bootstrap stops before GreenLight starts until the
# SigNoz credential below is replaced. The public GitHub repository works
# anonymously; add a read-only token only if you need a higher API rate limit.
GITHUB_TOKEN=
GITHUB_REPOSITORY=blnkfinance/blnk
SIGNOZ_API_KEY=<greenlight-service-account-key>

GREENLIGHT_ENV=development
GREENLIGHT_PORT=4000
GREENLIGHT_HOST=0.0.0.0
GREENLIGHT_SERVICE_VERSION=0.1.0
GREENLIGHT_DATABASE_PATH=/tmp/greenlight-unused.db
GREENLIGHT_API_KEYS=[]
GREENLIGHT_REQUIRE_READ_AUTH=false
GREENLIGHT_ALLOWED_ORIGINS=http://127.0.0.1:4173,http://localhost:4173
GREENLIGHT_HEALTH_ALLOWED_ORIGINS=http://127.0.0.1:18081,http://host.docker.internal:18081
GREENLIGHT_BODY_LIMIT_BYTES=1048576
GREENLIGHT_REQUEST_TIMEOUT_MS=15000
GREENLIGHT_RATE_LIMIT_PER_MINUTE=120
GREENLIGHT_MAX_CONCURRENT_REQUESTS=50
GREENLIGHT_PRIMARY_WORKFLOW_NAME="Build and Test"
SIGNOZ_URL=http://127.0.0.1:8080
SIGNOZ_MCP_URL=http://127.0.0.1:8000/mcp
OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318
OTEL_SERVICE_NAME=greenlight-api
CLAUDE_OTEL_SERVICE_NAME=claude-code
GREENLIGHT_DEMO_BRANCH=main
GREENLIGHT_BASELINE_WINDOW_SECONDS=90
GREENLIGHT_WARMUP_SECONDS=15
GREENLIGHT_OBSERVED_WINDOW_SECONDS=90
GREENLIGHT_INGESTION_DELAY_SECONDS=15
GREENLIGHT_MIN_SPANS=200
SIGNOZ_QUERY_TIMEOUT_MS=10000
SIGNOZ_QUERY_MAX_ATTEMPTS=3
GREENLIGHT_VERSION_VISIBILITY_TIMEOUT_MS=30000
GREENLIGHT_JOB_MAX_ATTEMPTS=5
GREENLIGHT_JOB_DEADLINE_MS=120000
GREENLIGHT_LOG_LEVEL=info
