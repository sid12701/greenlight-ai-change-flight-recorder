# Secrets. Only the checked-in templates are tracked.
.env
.env.*
!.env.example
!.env.demo.example

# Build and test output
node_modules/
dist/
coverage/
playwright-report/
test-results/
artifacts/
tmp/
*.log
*.pid

# Local demo state: the SQLite store, the fetched workload, and the
# Foundry-generated SigNoz topology. All are regenerated by `npm run demo:up`.
**/data/*.db
**/data/*.db-*
.workloads/
pours/

# Editor and agent scratch directories
.DS_Store
.idea/
.vscode/
.claude/
.codex/
