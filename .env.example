GREENLIGHT_PORT=4000
GREENLIGHT_DATABASE_PATH=./data/greenlight.db
# Required in production; the local file store cannot be shared between the
# API and the worker. Leave unset for local development.
# GREENLIGHT_DATABASE_URL=postgres://user:password@host:5432/greenlight
GREENLIGHT_ENV=development
GREENLIGHT_SERVICE_VERSION=0.1.0
GREENLIGHT_HOST=127.0.0.1
# Local development only; loadConfig rejects this in production.
GREENLIGHT_ADMIN_TOKEN=<24+-character-local-token>
GREENLIGHT_API_KEYS=[]
GREENLIGHT_REQUIRE_READ_AUTH=false
GREENLIGHT_ALLOWED_ORIGINS=http://127.0.0.1:4173,http://localhost:4173
GREENLIGHT_HEALTH_ALLOWED_ORIGINS=http://127.0.0.1:18081
GREENLIGHT_BODY_LIMIT_BYTES=1048576
GREENLIGHT_REQUEST_TIMEOUT_MS=15000
GREENLIGHT_RATE_LIMIT_PER_MINUTE=120
GREENLIGHT_MAX_CONCURRENT_REQUESTS=50
GITHUB_TOKEN=<set-locally>
GITHUB_REPOSITORY=your-org/greenlight
GREENLIGHT_PRIMARY_WORKFLOW_NAME="Backend CI"
SIGNOZ_URL=http://localhost:8080
# Origin used to build the SigNoz links published on a receipt. Only needs
# setting when the API reaches SigNoz at an address a reader's browser cannot,
# which is the case whenever the API runs in a container.
SIGNOZ_PUBLIC_URL=http://localhost:8080
SIGNOZ_API_KEY=<service-account-key-from-signoz>
SIGNOZ_MCP_URL=http://localhost:8000/mcp
SIGNOZ_DEPLOYMENT_DASHBOARD_ID=<imported-dashboard-id>
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAME=greenlight-api
CLAUDE_OTEL_SERVICE_NAME=claude-code
GREENLIGHT_DEMO_BRANCH=main
GREENLIGHT_BASELINE_WINDOW_SECONDS=90
GREENLIGHT_WARMUP_SECONDS=15
GREENLIGHT_OBSERVED_WINDOW_SECONDS=90
GREENLIGHT_INGESTION_DELAY_SECONDS=15
GREENLIGHT_MIN_SPANS=200
SIGNOZ_QUERY_TIMEOUT_MS=10000
SIGNOZ_QUERY_MAX_ATTEMPTS=3
GREENLIGHT_VERSION_VISIBILITY_TIMEOUT_MS=30000
GREENLIGHT_JOB_MAX_ATTEMPTS=5
GREENLIGHT_JOB_DEADLINE_MS=120000
GREENLIGHT_LOG_LEVEL=info
