{
  "name": "greenlight",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "echo 'Run npm run dev:api and npm run dev:web in separate terminals'",
    "dev:api": "npm --workspace @greenlight/api run dev",
    "dev:web": "npm --workspace @greenlight/web run dev",
    "validate:config": "node scripts/validate-config-contract.mjs",
    "validate:planning": "node scripts/validate-planning.mjs",
    "validate:telemetry": "node scripts/validate-telemetry-contract.mjs",
    "quality": "node scripts/quality-gates.mjs",
    "smoke:signoz": "bash scripts/signoz-smoke.sh",
    "smoke:backdated": "node scripts/backdated-span-smoke.mjs",
    "clean": "npm run clean --workspaces --if-present",
    "build": "npm run build --workspace @greenlight/shared && npm run build --workspace @greenlight/api && npm run build --workspace @greenlight/web",
    "test": "npm run test --workspace @greenlight/shared && npm run test --workspace @greenlight/api && npm run test --workspace @greenlight/web && node --test integrations/lms/load-home-overview.test.mjs scripts/signoz-assets.test.mjs",
    "typecheck": "npm run build --workspace @greenlight/shared && npm run typecheck --workspace @greenlight/api && npm run typecheck --workspace @greenlight/web",
    "verify": "npm run clean && npm run lint && npm run typecheck && npm test && npm run build",
    "test:compiled-start": "node scripts/compiled-start-smoke.mjs",
    "test:compiled-migrations": "node scripts/compiled-migration-smoke.mjs",
    "acceptance": "bash scripts/acceptance.sh",
    "test:e2e:smoke": "playwright test --grep @smoke",
    "validate:signoz-assets": "node scripts/signoz-assets.mjs validate",
    "signoz:import": "node scripts/signoz-assets.mjs import",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test:coverage": "npm run test --workspace @greenlight/api -- --coverage",
    "test:integration": "vitest run --root apps/api test/integration",
    "mcp:capture": "node scripts/capture-mcp-fixture.mjs",
    "mcp:verify": "node scripts/verify-mcp-result.mjs",
    "test:postgres": "vitest run --root apps/api test/integration/postgres.integration.test.ts"
  },
  "engines": {
    "node": ">=24 <25"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@playwright/test": "^1.54.1",
    "@vitest/coverage-v8": "^3.2.7",
    "eslint": "^10.7.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.7.0",
    "typescript-eslint": "^8.65.0"
  },
  "dependencies": {
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/exporter-trace-otlp-http": "^0.221.0",
    "@opentelemetry/resources": "^2.10.0",
    "@opentelemetry/sdk-trace-base": "^2.10.0",
    "@opentelemetry/semantic-conventions": "^1.43.0"
  }
}
