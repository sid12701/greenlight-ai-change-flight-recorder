{
  "name": "greenlight",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "echo 'Run npm run dev:api and npm run dev:web in separate terminals'",
    "dev:api": "npm --workspace @greenlight/api run dev",
    "dev:web": "npm --workspace @greenlight/web run dev",
    "validate:config": "node scripts/validate-config-contract.mjs",
    "validate:planning": "node scripts/validate-planning.mjs",
    "validate:telemetry": "node scripts/validate-telemetry-contract.mjs",
    "smoke:signoz": "bash scripts/signoz-smoke.sh",
    "smoke:backdated": "node scripts/backdated-span-smoke.mjs",
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "verify": "npm run typecheck && npm test && npm run build"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/exporter-trace-otlp-http": "^0.221.0",
    "@opentelemetry/resources": "^2.10.0",
    "@opentelemetry/sdk-trace-base": "^2.10.0",
    "@opentelemetry/semantic-conventions": "^1.43.0"
  }
}
