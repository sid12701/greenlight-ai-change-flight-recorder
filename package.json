{
  "name": "greenlight",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "echo 'Run npm run dev:api and npm run dev:web in separate terminals'",
    "dev:api": "npm --workspace @greenlight/api run dev",
    "dev:web": "npm --workspace @greenlight/web run dev",
    "verify": "npm run clean && npm run lint && npm run typecheck && npm test && npm run build",
    "clean": "npm run clean --workspaces --if-present",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "npm run build --workspace @greenlight/shared && npm run typecheck --workspace @greenlight/api && npm run typecheck --workspace @greenlight/web",
    "build": "npm run build --workspace @greenlight/shared && npm run build --workspace @greenlight/api && npm run build --workspace @greenlight/web",
    "test": "npm run test --workspace @greenlight/shared && npm run test --workspace @greenlight/api && npm run test --workspace @greenlight/web && node --test integrations/blnk/workload.test.mjs scripts/demo-config.test.mjs scripts/signoz-assets.test.mjs scripts/signoz-stack.test.mjs",
    "test:coverage": "npm run test --workspace @greenlight/api -- --coverage",
    "test:integration": "vitest run --root apps/api test/integration",
    "test:postgres": "vitest run --root apps/api test/integration/postgres.integration.test.ts",
    "test:e2e:smoke": "playwright test --grep @smoke",
    "test:compiled-start": "node scripts/compiled-start-smoke.mjs",
    "test:compiled-migrations": "node scripts/compiled-migration-smoke.mjs",
    "quality": "node scripts/quality-gates.mjs",
    "validate:config": "node scripts/validate-config-contract.mjs",
    "validate:telemetry": "node scripts/validate-telemetry-contract.mjs",
    "validate:signoz-assets": "node scripts/signoz-assets.mjs validate",
    "validate:signoz-stack": "node scripts/signoz-stack.mjs",
    "validate:runtime-images": "bash scripts/runtime-image-contract.sh",
    "demo:up": "bash scripts/demo-bootstrap.sh",
    "demo:status": "bash scripts/demo-bootstrap.sh --status",
    "demo:down": "bash scripts/demo-down.sh",
    "demo:chain": "node scripts/demo-chain.mjs",
    "demo:dependency-failure": "node scripts/demo-dependency-failure.mjs",
    "demo:rehearse": "bash scripts/demo-full-rehearsal.sh",
    "demo:capture": "node scripts/capture-demo-assets.mjs",
    "acceptance": "bash scripts/acceptance.sh",
    "signoz:import": "node scripts/signoz-assets.mjs import",
    "smoke:signoz": "bash scripts/signoz-smoke.sh",
    "smoke:backdated": "node scripts/backdated-span-smoke.mjs",
    "ai-link:arm": "bash instrumentation/git-hooks/install.sh .",
    "ai-link:verify": "node scripts/verify-ai-link.mjs",
    "mcp:capture": "node scripts/capture-mcp-fixture.mjs",
    "mcp:verify": "node scripts/verify-mcp-result.mjs",
    "verify:receipt-links": "node scripts/verify-receipt-links.mjs",
    "video:build": "bash scripts/build-submission-video.sh"
  },
  "engines": {
    "node": ">=24 <25"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@modelcontextprotocol/sdk": "1.29.0",
    "@playwright/test": "^1.54.1",
    "@vitest/coverage-v8": "4.1.10",
    "eslint": "^10.7.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.7.0",
    "typescript-eslint": "^8.65.0"
  },
  "dependencies": {
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/exporter-trace-otlp-http": "^0.221.0",
    "@opentelemetry/resources": "^2.10.0",
    "@opentelemetry/sdk-trace-base": "^2.10.0",
    "@opentelemetry/semantic-conventions": "^1.43.0"
  }
}
