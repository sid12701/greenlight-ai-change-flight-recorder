{
  "schemaVersion": "v1",
  "version": "v5",
  "alert": "GreenLight — deployed error rate high",
  "alertType": "TRACES_BASED_ALERT",
  "ruleType": "threshold_rule",
  "evalWindow": "1m",
  "frequency": "1m",
  "variables": [
    { "kind": "TextVariable", "spec": { "name": "service", "value": "blnk-loan-workload" } },
    { "kind": "TextVariable", "spec": { "name": "environment", "value": "hackathon-demo" } },
    { "kind": "TextVariable", "spec": { "name": "route", "value": "/balances" } }
  ],
  "condition": {
    "compositeQuery": {
      "schemaVersion": "v1",
      "queryType": "builder",
      "queries": [
        {
          "type": "builder_query",
          "spec": {
            "name": "A",
            "signal": "traces",
            "disabled": false,
            "aggregations": [
              {
                "expression": "count()"
              }
            ],
            "filter": {
              "expression": "service.name = $service AND deployment.environment.name = $environment AND http.route = $route AND has_error = true"
            }
          }
        },
        {
          "type": "builder_query",
          "spec": {
            "name": "B",
            "signal": "traces",
            "disabled": false,
            "aggregations": [
              {
                "expression": "count()"
              }
            ],
            "filter": {
              "expression": "service.name = $service AND deployment.environment.name = $environment AND http.route = $route"
            }
          }
        },
        {
          "type": "builder_formula",
          "spec": {
            "name": "F1",
            "expression": "A/B*100",
            "legend": "deployed error rate"
          }
        }
      ]
    },
    "op": ">",
    "target": 6,
    "matchType": "1",
    "selectedQueryName": "F1",
    "targetUnit": "%"
  },
  "labels": {
    "severity": "critical",
    "owner": "greenlight"
  },
  "annotations": {
    "summary": "Errored spans exceeded 6% of all spans on the evaluated route for whatever version is currently deployed.",
    "description": "A true rate: errored spans over all spans for the same scope, as a Query Builder v5 formula, rather than a raw error count that would rise with traffic alone. Deployment correlation is evidence of temporal and version association, not proof of causation. Open the GreenLight change receipt for the verified evidence chain and the version that was running."
  },
  "preferredChannels": []
}
