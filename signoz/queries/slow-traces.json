{
  "compositeQuery": {
    "queryType": "builder",
    "panelType": "table",
    "builderQueries": {
      "A": {
        "dataSource": "traces",
        "aggregateOperator": "noop",
        "aggregateAttribute": { "key": "durationNano" },
        "orderBy": [{ "columnName": "durationNano", "order": "desc" }],
        "limit": 3,
        "filters": {
          "items": [
            { "key": "service.name", "op": "=", "value": "{{serviceName}}" },
            { "key": "service.version", "op": "=", "value": "{{serviceVersion}}" },
            { "key": "deployment.environment.name", "op": "=", "value": "{{environmentName}}" },
            { "key": "http.route", "op": "=", "value": "{{route}}" }
          ]
        }
      }
    }
  },
  "start": "{{startMs}}",
  "end": "{{endMs}}",
  "step": 60
}
