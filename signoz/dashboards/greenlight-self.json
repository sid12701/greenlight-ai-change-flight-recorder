{
  "schemaVersion": "v6",
  "name": "greenlight-self-observability",
  "spec": {
    "display": {
      "name": "GreenLight \u2014 Self Observability",
      "description": "GreenLight's own API and worker telemetry: request volume, latency, errors and background job outcomes."
    },
    "variables": [],
    "panels": {
      "api-requests": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "API requests by route",
            "description": "Server spans handled by the GreenLight API."
          },
          "plugin": {
            "kind": "signoz/TimeSeriesPanel",
            "spec": {}
          },
          "queries": [
            {
              "kind": "time_series",
              "spec": {
                "plugin": {
                  "kind": "signoz/BuilderQuery",
                  "spec": {
                    "name": "A",
                    "signal": "traces",
                    "disabled": false,
                    "aggregations": [
                      {
                        "expression": "count()"
                      }
                    ],
                    "filter": {
                      "expression": "service.name = 'greenlight-api' AND kind_string = 'Server'"
                    },
                    "groupBy": [
                      {
                        "name": "http.route",
                        "fieldDataType": "string",
                        "fieldContext": "span"
                      }
                    ]
                  }
                }
              }
            }
          ]
        }
      },
      "api-latency": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "API latency p95",
            "description": "p95 duration of GreenLight API server spans."
          },
          "plugin": {
            "kind": "signoz/TimeSeriesPanel",
            "spec": {}
          },
          "queries": [
            {
              "kind": "time_series",
              "spec": {
                "plugin": {
                  "kind": "signoz/BuilderQuery",
                  "spec": {
                    "name": "A",
                    "signal": "traces",
                    "disabled": false,
                    "aggregations": [
                      {
                        "expression": "p95(duration_nano)"
                      }
                    ],
                    "filter": {
                      "expression": "service.name = 'greenlight-api' AND kind_string = 'Server'"
                    }
                  }
                }
              }
            }
          ]
        }
      },
      "api-errors": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "API server errors",
            "description": "GreenLight API spans that failed. Client input rejections are not counted as errors."
          },
          "plugin": {
            "kind": "signoz/TimeSeriesPanel",
            "spec": {}
          },
          "queries": [
            {
              "kind": "time_series",
              "spec": {
                "plugin": {
                  "kind": "signoz/BuilderQuery",
                  "spec": {
                    "name": "A",
                    "signal": "traces",
                    "disabled": false,
                    "aggregations": [
                      {
                        "expression": "count()"
                      }
                    ],
                    "filter": {
                      "expression": "service.name = 'greenlight-api' AND kind_string = 'Server' AND has_error = true"
                    }
                  }
                }
              }
            }
          ]
        }
      },
      "worker-jobs": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "Worker jobs by kind",
            "description": "Background job spans emitted by the GreenLight worker."
          },
          "plugin": {
            "kind": "signoz/TimeSeriesPanel",
            "spec": {}
          },
          "queries": [
            {
              "kind": "time_series",
              "spec": {
                "plugin": {
                  "kind": "signoz/BuilderQuery",
                  "spec": {
                    "name": "A",
                    "signal": "traces",
                    "disabled": false,
                    "aggregations": [
                      {
                        "expression": "count()"
                      }
                    ],
                    "filter": {
                      "expression": "service.name = 'greenlight-worker' AND name LIKE 'job %'"
                    },
                    "groupBy": [
                      {
                        "name": "greenlight.job.kind",
                        "fieldDataType": "string",
                        "fieldContext": "span"
                      }
                    ]
                  }
                }
              }
            }
          ]
        }
      },
      "worker-failures": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "Worker job failures",
            "description": "Job spans that ended in an error status, grouped by job kind."
          },
          "plugin": {
            "kind": "signoz/TimeSeriesPanel",
            "spec": {}
          },
          "queries": [
            {
              "kind": "time_series",
              "spec": {
                "plugin": {
                  "kind": "signoz/BuilderQuery",
                  "spec": {
                    "name": "A",
                    "signal": "traces",
                    "disabled": false,
                    "aggregations": [
                      {
                        "expression": "count()"
                      }
                    ],
                    "filter": {
                      "expression": "service.name = 'greenlight-worker' AND has_error = true"
                    },
                    "groupBy": [
                      {
                        "name": "greenlight.job.kind",
                        "fieldDataType": "string",
                        "fieldContext": "span"
                      }
                    ]
                  }
                }
              }
            }
          ]
        }
      }
    },
    "duration": "1h",
    "refreshInterval": "1m",
    "layouts": [
      {
        "kind": "Grid",
        "spec": {
          "items": [
            {
              "x": 0,
              "y": 0,
              "width": 6,
              "height": 6,
              "content": {
                "$ref": "#/spec/panels/api-requests"
              }
            },
            {
              "x": 6,
              "y": 0,
              "width": 6,
              "height": 6,
              "content": {
                "$ref": "#/spec/panels/api-latency"
              }
            },
            {
              "x": 0,
              "y": 6,
              "width": 6,
              "height": 6,
              "content": {
                "$ref": "#/spec/panels/api-errors"
              }
            },
            {
              "x": 6,
              "y": 6,
              "width": 6,
              "height": 6,
              "content": {
                "$ref": "#/spec/panels/worker-jobs"
              }
            },
            {
              "x": 0,
              "y": 12,
              "width": 6,
              "height": 6,
              "content": {
                "$ref": "#/spec/panels/worker-failures"
              }
            }
          ]
        }
      }
    ]
  }
}
