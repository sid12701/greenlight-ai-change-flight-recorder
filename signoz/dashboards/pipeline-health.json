{
  "schemaVersion": "v6",
  "name": "greenlight-pipeline-health",
  "spec": {
    "display": {
      "name": "GreenLight \u2014 Pipeline Health",
      "description": "Reconstructed GitHub Actions telemetry exported by the GreenLight worker: run volume, duration and failures per workflow."
    },
    "variables": [],
    "panels": {
      "runs-by-workflow": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "Reconstructed runs by workflow",
            "description": "Root spans of reconstructed workflow runs."
          },
          "plugin": {
            "kind": "signoz/TimeSeriesPanel",
            "spec": {}
          },
          "queries": [
            {
              "kind": "time_series",
              "spec": {
                "plugin": {
                  "kind": "signoz/BuilderQuery",
                  "spec": {
                    "name": "A",
                    "signal": "traces",
                    "disabled": false,
                    "aggregations": [
                      {
                        "expression": "count()"
                      }
                    ],
                    "filter": {
                      "expression": "service.name = 'greenlight-ci' AND name LIKE 'Reconstructed GitHub Actions:%'"
                    },
                    "groupBy": [
                      {
                        "name": "cicd.pipeline.name",
                        "fieldDataType": "string",
                        "fieldContext": "span"
                      }
                    ]
                  }
                }
              }
            }
          ]
        }
      },
      "run-duration-p95": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "Workflow run duration p95",
            "description": "p95 wall-clock duration of reconstructed workflow runs."
          },
          "plugin": {
            "kind": "signoz/TimeSeriesPanel",
            "spec": {}
          },
          "queries": [
            {
              "kind": "time_series",
              "spec": {
                "plugin": {
                  "kind": "signoz/BuilderQuery",
                  "spec": {
                    "name": "A",
                    "signal": "traces",
                    "disabled": false,
                    "aggregations": [
                      {
                        "expression": "p95(duration_nano)"
                      }
                    ],
                    "filter": {
                      "expression": "service.name = 'greenlight-ci' AND name LIKE 'Reconstructed GitHub Actions:%'"
                    }
                  }
                }
              }
            }
          ]
        }
      },
      "failed-steps": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "Failed steps",
            "description": "Reconstructed step spans whose GitHub conclusion was a failure."
          },
          "plugin": {
            "kind": "signoz/TimeSeriesPanel",
            "spec": {}
          },
          "queries": [
            {
              "kind": "time_series",
              "spec": {
                "plugin": {
                  "kind": "signoz/BuilderQuery",
                  "spec": {
                    "name": "A",
                    "signal": "traces",
                    "disabled": false,
                    "aggregations": [
                      {
                        "expression": "count()"
                      }
                    ],
                    "filter": {
                      "expression": "service.name = 'greenlight-ci' AND has_error = true"
                    },
                    "groupBy": [
                      {
                        "name": "github.step.name",
                        "fieldDataType": "string",
                        "fieldContext": "span"
                      }
                    ]
                  }
                }
              }
            }
          ]
        }
      },
      "slowest-jobs": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "Job duration p95",
            "description": "p95 duration of reconstructed job spans, to locate the slowest stage."
          },
          "plugin": {
            "kind": "signoz/TimeSeriesPanel",
            "spec": {}
          },
          "queries": [
            {
              "kind": "time_series",
              "spec": {
                "plugin": {
                  "kind": "signoz/BuilderQuery",
                  "spec": {
                    "name": "A",
                    "signal": "traces",
                    "disabled": false,
                    "aggregations": [
                      {
                        "expression": "p95(duration_nano)"
                      }
                    ],
                    "filter": {
                      "expression": "service.name = 'greenlight-ci' AND name LIKE 'job:%'"
                    },
                    "groupBy": [
                      {
                        "name": "cicd.pipeline.task.name",
                        "fieldDataType": "string",
                        "fieldContext": "span"
                      }
                    ]
                  }
                }
              }
            }
          ]
        }
      }
    },
    "duration": "1h",
    "refreshInterval": "1m",
    "layouts": [
      {
        "kind": "Grid",
        "spec": {
          "items": [
            {
              "x": 0,
              "y": 0,
              "width": 6,
              "height": 6,
              "content": {
                "$ref": "#/spec/panels/runs-by-workflow"
              }
            },
            {
              "x": 6,
              "y": 0,
              "width": 6,
              "height": 6,
              "content": {
                "$ref": "#/spec/panels/run-duration-p95"
              }
            },
            {
              "x": 0,
              "y": 6,
              "width": 6,
              "height": 6,
              "content": {
                "$ref": "#/spec/panels/failed-steps"
              }
            },
            {
              "x": 6,
              "y": 6,
              "width": 6,
              "height": 6,
              "content": {
                "$ref": "#/spec/panels/slowest-jobs"
              }
            }
          ]
        }
      }
    ]
  }
}
