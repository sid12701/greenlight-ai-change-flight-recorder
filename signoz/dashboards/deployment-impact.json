{
  "schemaVersion": "v6",
  "name": "greenlight-deployment-impact",
  "spec": {
    "display": {
      "name": "GreenLight — Deployment Impact",
      "description": "Request count, p90, p95 and error rate for one immutable service.version on one route. Backs the impact section of a change receipt."
    },
    "variables": [
      {
        "kind": "TextVariable",
        "spec": {
          "name": "service",
          "value": "blnk-loan-workload"
        }
      },
      {
        "kind": "TextVariable",
        "spec": {
          "name": "version",
          "value": "2fa6e2861eabf162a26af0d0ef012124865811df"
        }
      },
      {
        "kind": "TextVariable",
        "spec": {
          "name": "environment",
          "value": "hackathon-demo"
        }
      },
      {
        "kind": "TextVariable",
        "spec": {
          "name": "route",
          "value": "/balances"
        }
      }
    ],
    "panels": {
      "p95-by-version": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "p95 by deployed version",
            "description": "One series per immutable service.version on the same route. This is the comparison a change receipt makes, drawn rather than asserted: the step between two series is the deployment."
          },
          "unit": "ns",
          "plugin": {
            "kind": "signoz/TimeSeriesPanel",
            "spec": {}
          },
          "queries": [
            {
              "kind": "time_series",
              "spec": {
                "plugin": {
                  "kind": "signoz/BuilderQuery",
                  "spec": {
                    "name": "A",
                    "signal": "traces",
                    "disabled": false,
                    "aggregations": [
                      {
                        "expression": "p95(duration_nano)"
                      }
                    ],
                    "filter": {
                      "expression": "service.name = $service AND deployment.environment.name = $environment AND http.route = $route"
                    },
                    "groupBy": [
                      {
                        "name": "service.version",
                        "fieldDataType": "string",
                        "fieldContext": "resource"
                      }
                    ]
                  }
                }
              }
            }
          ]
        }
      },
      "errors-by-version": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "Errored spans by deployed version",
            "description": "Errored spans per immutable service.version on the same route, so a failure can be attributed to the version that was running rather than to a wall-clock window that may span two deployments."
          },
          "unit": "short",
          "plugin": {
            "kind": "signoz/TimeSeriesPanel",
            "spec": {}
          },
          "queries": [
            {
              "kind": "time_series",
              "spec": {
                "plugin": {
                  "kind": "signoz/BuilderQuery",
                  "spec": {
                    "name": "A",
                    "signal": "traces",
                    "disabled": false,
                    "aggregations": [
                      {
                        "expression": "count()"
                      }
                    ],
                    "filter": {
                      "expression": "service.name = $service AND deployment.environment.name = $environment AND http.route = $route AND has_error = true"
                    },
                    "groupBy": [
                      {
                        "name": "service.version",
                        "fieldDataType": "string",
                        "fieldContext": "resource"
                      }
                    ]
                  }
                }
              }
            }
          ]
        }
      },
      "request-count": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "Request count",
            "description": "Completed spans for the deployed version on the evaluated route."
          },
          "unit": "short",
          "plugin": {
            "kind": "signoz/TimeSeriesPanel",
            "spec": {}
          },
          "queries": [
            {
              "kind": "time_series",
              "spec": {
                "plugin": {
                  "kind": "signoz/BuilderQuery",
                  "spec": {
                    "name": "A",
                    "signal": "traces",
                    "disabled": false,
                    "aggregations": [
                      {
                        "expression": "count()"
                      }
                    ],
                    "filter": {
                      "expression": "service.name = $service AND service.version = $version AND deployment.environment.name = $environment AND http.route = $route"
                    }
                  }
                }
              }
            }
          ]
        }
      },
      "latency-p90": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "Latency p90",
            "description": "p90 request duration for the deployed version on the evaluated route."
          },
          "unit": "ns",
          "plugin": {
            "kind": "signoz/TimeSeriesPanel",
            "spec": {}
          },
          "queries": [
            {
              "kind": "time_series",
              "spec": {
                "plugin": {
                  "kind": "signoz/BuilderQuery",
                  "spec": {
                    "name": "A",
                    "signal": "traces",
                    "disabled": false,
                    "aggregations": [
                      {
                        "expression": "p90(duration_nano)"
                      }
                    ],
                    "filter": {
                      "expression": "service.name = $service AND service.version = $version AND deployment.environment.name = $environment AND http.route = $route"
                    }
                  }
                }
              }
            }
          ]
        }
      },
      "latency-p95": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "Latency p95",
            "description": "p95 request duration for the deployed version on the evaluated route."
          },
          "unit": "ns",
          "plugin": {
            "kind": "signoz/TimeSeriesPanel",
            "spec": {}
          },
          "queries": [
            {
              "kind": "time_series",
              "spec": {
                "plugin": {
                  "kind": "signoz/BuilderQuery",
                  "spec": {
                    "name": "A",
                    "signal": "traces",
                    "disabled": false,
                    "aggregations": [
                      {
                        "expression": "p95(duration_nano)"
                      }
                    ],
                    "filter": {
                      "expression": "service.name = $service AND service.version = $version AND deployment.environment.name = $environment AND http.route = $route"
                    }
                  }
                }
              }
            }
          ]
        }
      },
      "error-count": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "Error count",
            "description": "Spans marked as errors for the deployed version."
          },
          "unit": "short",
          "plugin": {
            "kind": "signoz/TimeSeriesPanel",
            "spec": {}
          },
          "queries": [
            {
              "kind": "time_series",
              "spec": {
                "plugin": {
                  "kind": "signoz/BuilderQuery",
                  "spec": {
                    "name": "A",
                    "signal": "traces",
                    "disabled": false,
                    "aggregations": [
                      {
                        "expression": "count()"
                      }
                    ],
                    "filter": {
                      "expression": "service.name = $service AND service.version = $version AND deployment.environment.name = $environment AND http.route = $route AND has_error = true"
                    }
                  }
                }
              }
            }
          ]
        }
      },
      "deployment-markers": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "Deployment markers",
            "description": "deployment.started / succeeded / failed spans emitted by the GreenLight worker under the workload's own resource identity."
          },
          "unit": "short",
          "plugin": {
            "kind": "signoz/TimeSeriesPanel",
            "spec": {}
          },
          "queries": [
            {
              "kind": "time_series",
              "spec": {
                "plugin": {
                  "kind": "signoz/BuilderQuery",
                  "spec": {
                    "name": "A",
                    "signal": "traces",
                    "disabled": false,
                    "aggregations": [
                      {
                        "expression": "count()"
                      }
                    ],
                    "filter": {
                      "expression": "service.name = $service AND deployment.environment.name = $environment AND name LIKE 'deployment.%'"
                    },
                    "groupBy": [
                      {
                        "name": "name",
                        "fieldDataType": "string",
                        "fieldContext": "span"
                      }
                    ]
                  }
                }
              }
            }
          ]
        }
      }
    },
    "duration": "30m",
    "refreshInterval": "1m",
    "layouts": [
      {
        "kind": "Grid",
        "spec": {
          "items": [
            {
              "x": 0,
              "y": 0,
              "width": 6,
              "height": 6,
              "content": {
                "$ref": "#/spec/panels/p95-by-version"
              }
            },
            {
              "x": 6,
              "y": 0,
              "width": 6,
              "height": 6,
              "content": {
                "$ref": "#/spec/panels/errors-by-version"
              }
            },
            {
              "x": 0,
              "y": 6,
              "width": 6,
              "height": 6,
              "content": {
                "$ref": "#/spec/panels/request-count"
              }
            },
            {
              "x": 6,
              "y": 6,
              "width": 6,
              "height": 6,
              "content": {
                "$ref": "#/spec/panels/latency-p90"
              }
            },
            {
              "x": 0,
              "y": 12,
              "width": 6,
              "height": 6,
              "content": {
                "$ref": "#/spec/panels/latency-p95"
              }
            },
            {
              "x": 6,
              "y": 12,
              "width": 6,
              "height": 6,
              "content": {
                "$ref": "#/spec/panels/error-count"
              }
            },
            {
              "x": 0,
              "y": 18,
              "width": 6,
              "height": 6,
              "content": {
                "$ref": "#/spec/panels/deployment-markers"
              }
            }
          ]
        }
      }
    ]
  }
}
