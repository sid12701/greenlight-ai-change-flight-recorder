# Claude Code privacy-safe telemetry (OTLP HTTP → SigNoz)
# Pin the verified Claude Code version in README before demo.
# Verified reference: claude --version (record in PROVENANCE / README)

export CLAUDE_CODE_ENABLE_TELEMETRY=1
export CLAUDE_CODE_ENHANCED_TELEMETRY_BETA=1
export CLAUDE_CODE_PROPAGATE_TRACEPARENT=1

export OTEL_TRACES_EXPORTER=otlp
export OTEL_LOGS_EXPORTER=otlp
export OTEL_METRICS_EXPORTER=otlp
export OTEL_TRACES_SAMPLER=always_on
export OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
export OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# Privacy posture, chosen deliberately rather than defaulted.
#
# User prompts ARE exported: a receipt that names the session which produced a
# change is far more useful when it can also show what that session was asked to
# do. Anything typed into an instrumented session is therefore recorded in
# SigNoz and readable by anyone who can read the trace store.
#
# Tool arguments and tool output stay off. Those carry file contents, command
# output and credentials read during a run, which is a much larger surface than
# the prompt text and is not needed to explain a change.
export OTEL_LOG_USER_PROMPTS=1
export OTEL_LOG_TOOL_DETAILS=0
export OTEL_LOG_TOOL_CONTENT=0
