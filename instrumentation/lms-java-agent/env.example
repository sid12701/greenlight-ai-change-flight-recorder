# OpenTelemetry Java agent for LMS backend demo — GL-P1-T02
# Download once to the path below (not committed).

OTEL_JAVAAGENT_VERSION=2.14.0
OTEL_JAVAAGENT_JAR=${GREENLIGHT_ROOT:-.}/instrumentation/lms-java-agent/opentelemetry-javaagent.jar
OTEL_JAVAAGENT_DOWNLOAD_URL=https://github.com/open-telemetry/opentelemetry-java-instrumentation/releases/download/v${OTEL_JAVAAGENT_VERSION}/opentelemetry-javaagent.jar

SERVER_PORT=8081
SPRING_PROFILES_ACTIVE=local

OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
OTEL_TRACES_SAMPLER=always_on
OTEL_METRICS_EXPORTER=none
OTEL_LOGS_EXPORTER=none

# Set LMS_SHA to the full 40-character commit before deploy.
# OTEL_RESOURCE_ATTRIBUTES is assembled by deploy.sh from LMS_SHA.
